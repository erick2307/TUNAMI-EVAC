;;********************************************************************
;; A star searched by patches
;; Developed by E. Mas
;; October 2011
;; improved from the A star of \citep{Steiner2009}
;;*********************************************************************
;; The library needs in your model to include patches with the following
;; attributes "patches-own [f g h class parent]"
;; the program will report a list with the patches of path from start to target
;;
;; TUNAMI-EVAC VERSION 2 NOTE
;; This is the optimized A* implementation introduced with TUNAMI-EVAC 2.0.0.
;; It replaces the original 2011 implementation while retaining the same public
;; Astar reporter interface. See CHANGELOG.md for the release history, benchmark
;; results, and current validation scope.
;;
;;*********************************************************************
;; PERFORMANCE REWRITE (2026)
;; This rewrite is intended to preserve search behavior while removing redundant work.
;; Previously each iteration of the main loop scanned *every* patch in the
;; world three times (once to count the open list, once to rebuild it, and
;; the reset at the start of each call), and recomputed f/g/h for the whole
;; open list, where each f required walking the parent chain back to start.
;; On this model's 264 x 230 world that was ~120,000 patch visits per
;; iteration, which dominated the run time.
;;
;; Now:
;;   * the open list is kept as an explicit list, so no world-wide scans;
;;   * "gcum" holds the cumulative cost from start, updated incrementally,
;;     so the parent-chain walk (old "path-cost") is gone;
;;   * f/g/h are computed only when a patch is opened or re-parented,
;;     instead of for the entire open list every iteration;
;;   * only the patches actually touched by a search are reset, at the end
;;     of that search, instead of scanning the whole world at the start.
;; A matched release benchmark found identical evacuation records for 20 searches
;; and about 45x lower inclusive A* runtime. See CHANGELOG.md for limitations.
;;*********************************************************************


globals
[ start
  target
  space-color
  heuristic
]

patches-own [f g h gcum parent open?] ;in my original model I already had "class" you should include it if you do not have it
;open? 0 = NA, 1= open, 2= close
;gcum = cumulative cost from start down the parent chain (g is the single step from parent)

to-report Astar [ setup-start setup-target setup-color behavior ]
  set start setup-start
  set target setup-target
  set space-color setup-color
  set heuristic list behavior behavior
  ask target [set pcolor space-color]

;1) Begin at the starting point A and add it to an Ågopen listÅh of squares to be considered.
;The open list is kind of like a shopping list. Right now there is just one item on the list, but we will have more later.
;It contains squares that might fall along the path you want to take, but maybe not. Basically, this is a list of squares that need to be checked out.

  ask start [set open? 1 set parent self fgh-values]

  let open-list (list start)     ;; explicit open list: no "patches with [open? = 1]" scans
  let touched (list start)       ;; only these get reset when the search ends
  let failed? false

while [ [open?] of target != 2 and not failed? ]
[ ifelse empty? open-list
  [ set failed? true ]
  [

;choose the lowest F score square from all those that are on the open list.

  let current min-one-of (patch-set open-list) [f]

;4) Drop it from the open list and add it to the closed list

  set open-list remove current open-list
  ask current [set open? 2]; sprout 1 [ set shape "bot" set color red stamp die ] ]
;  display

;5) Check all of the adjacent squares. Ignoring those that are on the closed list or unwalkable (terrain with walls, water, or other illegal terrain),
;add squares to the open list if they are not on the open list already. Make the selected square the ÅgparentÅh of the new squares.

  let walkable [neighbors with [pcolor = space-color]] of current
  ask walkable [ if open? != 2 ;not close
                    [ ifelse open? != 1 ;not open
                      [ set open? 1
                        set parent current
                        fgh-values
                        set open-list fput self open-list
                        set touched fput self touched
                      ]

;6) If an adjacent square is already on the open list, check to see if this path to that square is a better one.
;In other words, check to see if the G score for that square is lower if we use the current square to get there. If not, donÅft do anything.
;On the other hand, if the G cost of the new path is lower, change the parent of the adjacent square to the selected square
;Finally, recalculate both the F and G scores of that square. If this seems confusing, you will see it illustrated below.

                      [ if gcum > ( ([gcum] of current) + (precision (distance-nowrap current) 2) )
                        [ set parent current fgh-values ]
                      ]
                   ]
               ]
  ]
]

let result [ ]
if not failed?
[ ask target [set pcolor green]
  set result show-path
]

;; release the patch variables used by this search (only the ones touched)
foreach touched [ p -> ask p [ set f 0 set g 0 set h 0 set gcum 0 set parent nobody set open? 0 ] ]

report result
end

to fgh-values ;patch procedure, assumes "parent" is already set
set g precision distance-nowrap parent 2
set gcum ifelse-value (self = start) [ 0 ] [ (([gcum] of parent) + g) ]
set h precision #heuristic 2
set f gcum + h
end

to-report show-path
let brush target
let my-path [ ]
set my-path fput brush my-path
while [ brush != start ]
[ set my-path fput ([parent] of brush) my-path
  set brush [parent] of brush
]
report my-path
end

to-report #heuristic
;  let heuristic [me]

  if first heuristic = -1
  [report 0]

  if first heuristic = 0
  [ report precision distance-nowrap target 2 ]

  if first heuristic = 1
  [ let xdiff abs(pxcor - [pxcor] of  target )
    let ydiff abs(pycor - [pycor] of  target )
    let result ( xdiff + ydiff )
    report result ]

  if first heuristic = 2
  [ let D  1
    let D2 1.414214
    let xdiff abs(pxcor - [pxcor] of target)
    let ydiff abs(pycor - [pycor] of target)
    let h_diagonal min (list xdiff ydiff)
    let h_straight xdiff + ydiff
    let result D2 * h_diagonal + D * ( h_straight - 2 * h_diagonal )
    report result ]

  if first heuristic = 3
  [ let D  1
    let D2 1.414214
    let xdiff abs(pxcor - [pxcor] of target )
    let ydiff abs(pycor - [pycor] of target )
    let h_diagonal min (list xdiff ydiff)
    let h_straight xdiff + ydiff
    let result D2 * h_diagonal + D * ( h_straight - 2 * h_diagonal )

    ;; tie-breaker: nudge H up by a small amount
    let h-scale (1 + (16 / 8 / world-width * world-height))
    set result result * h-scale
    report result ]

  if first heuristic = 4
  [ let result distance-nowrap target
    let h-scale (1 + (16 / 8 / world-width + world-height))
    set result result * h-scale
    report result ]
end
